# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Real backend origin (used by Next.js rewrite proxy + server-side fetches)
NEXT_PUBLIC_API_URL=https://api.unapologeticnm.com
API_URL=https://api.unapologeticnm.com

# Browser calls go to /api/backend/* (same-origin) and are rewritten to API_URL.
# Do not call https://api.unapologeticnm.com directly from the browser — CORS is blocked.
